# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The hub image to run, with a pinned tag.
HUB_IMAGE=ghcr.io/your-name/context-hub:sha-0123456789ab

# The hub's public address: https, no path, no trailing slash. Turns on sign-in
# for the Claude apps and the install script for new computers.
PUBLIC_URL=https://hub.example.com

# Writes session summaries and project briefings. Without it, uploads and
# lookups still work and summaries wait in a queue. Billed separately from a
# Claude subscription; create one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional. These are the defaults.
# DIGEST_MODEL=claude-haiku-5-5
# DIGEST_EFFORT=low
# DIGEST_MAX_INPUT_TOKENS=60000

# Optional: shown on the dashboard as the running version.
# IMAGE_TAG=sha-0123456789ab
