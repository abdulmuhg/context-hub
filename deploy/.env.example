# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The hub's DNS name, pointing at this server. PUBLIC_URL is built from it.
HUB_DOMAIN=hub.example.com

# Optional: pin the image to a tag instead of following :latest.
# HUB_IMAGE=ghcr.io/abdulmuhg/context-hub:sha-0123456789ab

# Optional, and only a fallback. Computers with Claude Code write their own
# summaries on your Claude plan, so the hub needs no key. With one, the hub
# writes the summaries of sessions that arrive without one (a computer without
# Claude Code). Billed separately from a Claude subscription; create one at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional. These are the defaults.
# DIGEST_MODEL=claude-haiku-5-5
# DIGEST_EFFORT=low
# DIGEST_MAX_INPUT_TOKENS=60000
# A daily limit in US dollars for the fallback's summaries (UTC day). They wait until 00:00 UTC once it is reached.
# DIGEST_DAILY_BUDGET_USD=2

# Optional: shown on the dashboard as the running version.
# IMAGE_TAG=sha-0123456789ab

# Optional: log verbosity, one of debug, info, warn, error. Default info.
# LOG_LEVEL=info
